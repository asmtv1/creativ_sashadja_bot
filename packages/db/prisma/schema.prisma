generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  YOOKASSA
  TELEGRAM_STARS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  REFUNDED
}

enum AccessSource {
  PAYMENT
  ADMIN
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxType {
  PAYMENT_SUCCEEDED
  NPD_RECEIPT_ISSUED
  ACCESS_GRANTED
  ACCESS_REVOKED
}

enum NpdConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISABLED
}

enum NpdReceiptStatus {
  PENDING
  ISSUED
  RECONCILIATION_REQUIRED
  FAILED
}

enum NpdReceiptOperationStatus {
  PENDING
  PROCESSING
  RETRY
  SUCCEEDED
  RECONCILIATION_REQUIRED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ChannelSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED_AT_PERIOD_END
  EXPIRED
  REFUNDED
}

enum ChannelPaymentKind {
  INITIAL
  RENEWAL
  MANUAL_RENEWAL
}

enum ChannelPaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
  REFUNDED
}

enum ReceiptOperationType {
  ISSUE
  CANCEL
}

enum ReceiptOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ChannelMembershipSource {
  MANAGED
  MANUAL
  EXEMPT
}

model TelegramUser {
  id           String         @id @default(uuid()) @db.Uuid
  telegramId   String         @unique
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orders       Order[]
  access       CourseAccess[]
  channelSubscriptions ChannelSubscription[]
  npdReceipts  NpdReceipt[]
}

model ChannelProduct {
  id                 String                @id @default(uuid()) @db.Uuid
  slug               String                @unique
  title              String
  priceKopecks       Int
  currency           String                @default("RUB")
  periodDays         Int                   @default(30)
  renewalLeadMinutes Int                   @default(240)
  gracePeriodMinutes Int                   @default(1440)
  enabled            Boolean               @default(false)
  telegramChatId     String?
  telegramChatTitle  String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  subscriptions      ChannelSubscription[]
}

model ChannelSubscription {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @db.Uuid
  productId          String                    @db.Uuid
  status             ChannelSubscriptionStatus @default(PENDING)
  autoRenew          Boolean                   @default(true)
  paymentMethodId    String?
  periodStart        DateTime?
  periodEnd          DateTime?
  nextChargeAt       DateTime?
  nextAttemptAt      DateTime?
  attemptCount       Int                       @default(0)
  reminderSentForEnd DateTime?
  termsVersion       String?
  termsAcceptedAt    DateTime?
  cancelRequestedAt  DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               TelegramUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            ChannelProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  payments           ChannelPayment[]
  invites            ChannelInvite[]
  membership         ChannelMembership?

  @@unique([userId, productId])
  @@index([nextChargeAt])
  @@index([nextAttemptAt])
  @@index([periodEnd])
}

model ChannelPayment {
  id                String               @id @default(uuid()) @db.Uuid
  subscriptionId    String               @db.Uuid
  kind              ChannelPaymentKind
  status            ChannelPaymentStatus @default(PENDING)
  amountKopecks     Int
  currency          String
  providerPaymentId String?              @unique
  idempotenceKey    String               @unique
  confirmationUrl   String?
  failureCode       String?
  providerPayload   Json?
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  subscription      ChannelSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  receipts          ReceiptOperation[]
  npdReceipt        NpdReceipt?

  @@index([subscriptionId, status])
}

model ChannelInvite {
  id             String              @id @default(uuid()) @db.Uuid
  subscriptionId String              @db.Uuid
  inviteLink     String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime            @default(now())
  subscription   ChannelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, expiresAt])
}

model ChannelMembership {
  id             String                  @id @default(uuid()) @db.Uuid
  subscriptionId String                  @unique @db.Uuid
  source         ChannelMembershipSource
  joinedAt       DateTime?
  removedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  subscription   ChannelSubscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model ReceiptOperation {
  id              String                 @id @default(uuid()) @db.Uuid
  paymentId       String                 @db.Uuid
  type            ReceiptOperationType
  status          ReceiptOperationStatus @default(PENDING)
  externalId      String?
  receiptUrl      String?
  attempts        Int                    @default(0)
  nextAttemptAt   DateTime               @default(now())
  lastError       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  payment         ChannelPayment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, type])
  @@index([status, nextAttemptAt])
}

model Course {
  id            String         @id @default(uuid()) @db.Uuid
  slug          String         @unique
  title         String
  description   String
  priceKopecks  Int
  currency      String         @default("RUB")
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lessons       Lesson[]
  orders        Order[]
  access        CourseAccess[]
}

model Lesson {
  id               String   @id @default(uuid()) @db.Uuid
  courseId         String   @db.Uuid
  slug             String
  sortOrder        Int
  title            String
  description      String?
  durationSeconds  Int?
  kinescopeVideoId String
  kinescopeEmbedUrl String
  posterUrl        String?
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@unique([courseId, sortOrder])
}

model Order {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  courseId          String          @db.Uuid
  provider          PaymentProvider @default(YOOKASSA)
  status            OrderStatus     @default(PENDING)
  amountKopecks     Int
  currency          String
  providerPaymentId String?         @unique
  paymentUrl        String?
  idempotenceKey    String          @unique
  paidAt            DateTime?
  canceledAt        DateTime?
  refundedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              TelegramUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  payments          Payment[]
  access            CourseAccess[]
  npdReceipt        NpdReceipt?
}

/// Singleton NPD connection. Refresh tokens are AES-256-GCM encrypted at rest.
model NpdConnection {
  id                     String              @id @default("default") @db.VarChar(32)
  inn                    String              @db.VarChar(12)
  deviceId               String              @db.VarChar(128)
  refreshTokenCipher     Bytes
  refreshTokenIv         Bytes
  refreshTokenTag        Bytes
  refreshTokenKeyVersion Int
  status                 NpdConnectionStatus @default(ACTIVE)
  fiscalizationStartedAt DateTime?
  lastAuthorizedAt       DateTime?
  lastSuccessfulOperationAt DateTime?
  lastRefreshedAt        DateTime?
  lastErrorCode          String?             @db.VarChar(64)
  lastErrorRedacted      String?             @db.VarChar(1024)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  receipts               NpdReceipt[]
}

model NpdReceipt {
  id                 String           @id @default(uuid()) @db.Uuid
  orderId            String?          @unique @db.Uuid
  channelPaymentId   String?          @unique @db.Uuid
  userId             String           @db.Uuid
  connectionId       String           @default("default") @db.VarChar(32)
  status             NpdReceiptStatus @default(PENDING)
  amountKopecks      Int
  currency           String           @default("RUB") @db.VarChar(3)
  serviceName        String           @db.VarChar(256)
  telegramId         String
  operationAt        DateTime
  providerReceiptId  String?          @unique @db.VarChar(128)
  printUrl           String?          @db.VarChar(2048)
  jsonUrl            String?          @db.VarChar(2048)
  issuedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  order              Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  channelPayment     ChannelPayment?  @relation(fields: [channelPaymentId], references: [id], onDelete: Restrict)
  user               TelegramUser     @relation(fields: [userId], references: [id], onDelete: Restrict)
  connection         NpdConnection    @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  operations         NpdReceiptOperation[]

  @@index([connectionId, status, createdAt])
}

model NpdReceiptOperation {
  id                String                    @id @default(uuid()) @db.Uuid
  receiptId         String                    @db.Uuid
  status            NpdReceiptOperationStatus @default(PENDING)
  attemptCount      Int                       @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?                 @default(now())
  leaseOwner        String?                   @db.VarChar(128)
  leaseExpiresAt    DateTime?
  completedAt       DateTime?
  lastErrorCode     String?                   @db.VarChar(64)
  lastErrorRedacted String?                   @db.VarChar(1024)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  receipt           NpdReceipt                @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @db.Uuid
  provider          PaymentProvider
  providerPaymentId String          @unique
  status            PaymentStatus
  amountKopecks     Int
  currency          String
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CourseAccess {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  courseId  String       @db.Uuid
  source    AccessSource
  orderId   String?      @db.Uuid
  grantedAt DateTime     @default(now())
  revokedAt DateTime?
  user      TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
}

model BotOutbox {
  id            String       @id @default(uuid()) @db.Uuid
  telegramId    String
  type          OutboxType
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedAt      DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model WebhookEvent {
  id               String          @id @default(uuid()) @db.Uuid
  provider         PaymentProvider
  providerEventKey String          @unique
  status           WebhookStatus   @default(RECEIVED)
  rawPayload       Json
  processedAt      DateTime?
  createdAt        DateTime        @default(now())
}

model AdminAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  action         String
  actor          String
  targetUserId   String?  @db.Uuid
  targetCourseId String?  @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now())
}
