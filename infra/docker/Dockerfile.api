FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json eslint.config.mjs ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
ENV DATABASE_URL=postgresql://course:course@postgres:5432/course?schema=public
RUN pnpm db:generate
RUN pnpm --filter @course/api build
RUN PRISMA_DIR="$(find node_modules/.pnpm -maxdepth 1 -type d -name '@prisma+client@*' | head -1)" && \
    mkdir -p /prisma-artifacts && \
    cp -r "$PRISMA_DIR/node_modules/.prisma" /prisma-artifacts/ && \
    cp -r "$PRISMA_DIR/node_modules/@prisma/client" /prisma-artifacts/client

FROM node:22-alpine AS runner
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared
COPY apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/dist ./apps/api/dist
RUN pnpm install --frozen-lockfile --prod --filter @course/api...
COPY --from=build /prisma-artifacts /prisma-artifacts
RUN PRISMA_DIR="$(find node_modules/.pnpm -maxdepth 1 -type d -name '@prisma+client@*' | head -1)" && \
    cp -r /prisma-artifacts/.prisma "$PRISMA_DIR/node_modules/" && \
    cp -r /prisma-artifacts/client/. "$PRISMA_DIR/node_modules/@prisma/client/"
ENV NODE_ENV=production
CMD ["node", "apps/api/dist/main.js"]
