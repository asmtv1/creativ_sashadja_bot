FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json eslint.config.mjs ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
ENV DATABASE_URL=postgresql://course:course@postgres:5432/course?schema=public
RUN pnpm db:generate
RUN pnpm --filter @course/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/db/package.json packages/db/prisma ./packages/db/
COPY packages/shared ./packages/shared
COPY apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/dist ./apps/api/dist
RUN pnpm install --frozen-lockfile --prod --filter @course/api...
RUN pnpm add -D prisma@6.19.3 --filter @course/db
ENV DATABASE_URL=postgresql://course:course@postgres:5432/course?schema=public
RUN pnpm db:generate
CMD ["node", "apps/api/dist/main.js"]
