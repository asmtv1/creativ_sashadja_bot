FROM node:22-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.json eslint.config.mjs ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @course/miniapp build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/apps/miniapp/.next/standalone ./
COPY --from=build /app/apps/miniapp/.next/static ./apps/miniapp/.next/static
COPY --from=build /app/apps/miniapp/public ./apps/miniapp/public
EXPOSE 3000
CMD ["node", "apps/miniapp/server.js"]
