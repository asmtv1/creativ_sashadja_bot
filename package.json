{
  "name": "telegram-course-bot",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @course/db prisma:generate",
    "db:migrate": "pnpm --filter @course/db prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @course/db prisma:migrate:deploy",
    "db:seed": "pnpm --filter @course/db prisma:seed"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.20",
    "@swc/core": "^1.15.8",
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
